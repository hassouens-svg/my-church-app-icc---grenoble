# Copier ce fichier en ".env" puis adapter les valeurs.

# Base de données : SQLite par défaut (aucune installation nécessaire).
# Pour PostgreSQL : postgresql+psycopg://user:motdepasse@localhost:5432/icc
DATABASE_URL=sqlite:///./icc.db

# Clé secrète pour signer les jetons de connexion (à changer en production !)
SECRET_KEY=change-moi-par-une-longue-chaine-aleatoire

# Durée de validité d'une connexion (en minutes)
TOKEN_EXPIRE_MINUTES=720

# Adresses autorisées à appeler l'API (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173

# Remplir la base avec des données de démonstration au premier démarrage
SEED_DEMO_DATA=true
